# 模型连接；地址和密钥只在本地配置
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
STRUCTURED_OUTPUT=off
LLM_TEMPERATURE=
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=3000
# qwen3 默认思考会让单次调用 20 秒以上且正文为空
LLM_DISABLE_THINKING=on

# 运行限制
MAX_INPUT_CHARS=4000
MAX_USER_ID_CHARS=64
MAX_TURNS=12
MAX_TOOL_CALLS=20
RUN_TIMEOUT=180
TOOL_TIMEOUT=60
TOP_K_DEFAULT=8
TOP_K_MAX=20
SEARCH_SNIPPET_CHARS=300
READ_MAX_CHARS=6000

# 检索与存储
# 正式源码使用外部 RAG 运行库；mock/sample 仅在另行提供样例数据时可用
KB_BACKEND=rag
# 仅 KB_BACKEND=rag 时需要：指向恢复后的运行库目录，留空会启动即报错
RAG_STORE_PROJECT=
RAG_MODE=bm25
SESSION_PATH=data/sessions.sqlite
RUN_LOG=data/runs.jsonl
LOG_CONTENT=off
